; ACTION-5 — Godot 4.7.2-stable (D03 actor locomotion in five camera modes).
; Runtime and export settings are pinned for web (Compatibility renderer).

config_version=5

[application]

config/name="ACTION-5 — Five Views"
run/main_scene="res://demo/main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/description="ACTION-5: shared 3D action-game framework foundation"
run/low_processor_mode=false

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"

[physics]

common/physics_ticks_per_second=60

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.035, 0.050, 0.074, 1)
textures/default_filters/use_nearest_mipmap_filter=false
